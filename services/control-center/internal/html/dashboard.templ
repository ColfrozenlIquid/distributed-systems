package html

import "fmt"

templ DashboardPage(props DashboardPageData) {
	@BaseLayout(props.Title) {
		<main class="dashboard-shell" data-testid="dashboard-page">
			<header class="dashboard-header">
				<div>
					<h1 class="dashboard-title">{ props.Title }</h1>
					<p class="dashboard-meta">
						{ props.Width }x{ props.Height } island grid - updated { props.GeneratedAt.Format("15:04:05") }
					</p>
				</div>
				<nav class="dashboard-actions" aria-label="Dashboard actions">
					<a class="dashboard-link" href="/map" aria-current="page">Map</a>
					<a class="dashboard-link" href="/status">Status JSON</a>
					<a class="dashboard-link" href="/ricart/status">Ricart JSON</a>
				</nav>
			</header>
			<div class="dashboard-grid">
				@MapPanel(props)
				@SidePanel(props)
			</div>
			@templ.JSONScript("dashboard-map-data", props.MapData)
		</main>
	}
}

templ MapPanel(props DashboardPageData) {
	<section class="map-panel" aria-labelledby="map-heading" data-testid="map-panel">
		<div class="map-toolbar">
			<h2 id="map-heading" class="map-heading">World map</h2>
			@Legend(props.Legend)
		</div>
		@templ.Fragment("world-map") {
			<div
				class="world-map"
				role="grid"
				aria-label="20 by 20 world tile map"
				data-dashboard-map
				data-testid="world-map"
			>
				for _, row := range props.Tiles {
					@MapRow(row)
				}
			</div>
		}
	</section>
}

templ MapRow(row []DashboardTile) {
	for _, tile := range row {
		@MapTile(tile)
	}
}

templ MapTile(tile DashboardTile) {
	<button
		type="button"
		role="gridcell"
		aria-pressed="false"
			class={
				"map-tile",
				templ.KV("is-land", tile.Terrain == "land"),
				templ.KV("is-water", tile.Terrain == "water"),
				templ.KV("has-infrastructure", tile.HasInfrastructure),
			templ.KV("has-sensor", tile.HasSensor),
			templ.KV("has-actor", tile.HasActor),
					templ.KV("has-incident", tile.HasIncident),
					templ.KV("reading-warning", tile.ReadingTone == "warning"),
					templ.KV("reading-critical", tile.ReadingTone == "critical"),
					templ.KV("ricart-active", tile.RicartLabel != ""),
			}
			{ tileAttributes(tile)... }
	>
		if tile.HasInfrastructure {
			<span aria-hidden="true">{ tile.InfrastructureShort }</span>
		}
		if tile.RicartLabel != "" {
			<span class={ "tile-ricart", templ.KV("tile-ricart-critical", tile.RicartTone == "critical"), templ.KV("tile-ricart-warning", tile.RicartTone == "warning") } title={ tile.RicartHint }>{ tile.RicartLabel }</span>
		}
		if tile.ReadingLabel != "" {
			<span class="tile-reading">{ tile.ReadingLabel }</span>
		}
	</button>
}

templ Legend(items []LegendItem) {
	<dl class="legend" aria-label="Map legend">
		for _, item := range items {
			<div class="legend-item">
				<dt><span class={ "legend-swatch", item.Class }></span></dt>
				<dd>{ item.Label }</dd>
			</div>
		}
	</dl>
}

	templ SidePanel(props DashboardPageData) {
		<aside class="side-panel" aria-label="System overview" data-testid="side-panel">
			@SummaryCards(props.Summary)
			@RicartFeed(props.Ricart)
			@ReadingsFeed(props.Readings)
			@IncidentsFeed(props.Incidents)
			@SensorsFeed(props.Sensors)
			@ActorsFeed(props.Actors)
	</aside>
}

templ SummaryCards(summary DashboardSummary) {
	<section class="summary-grid" aria-label="Map summary" data-testid="summary-grid">
		@MetricCard("Land tiles", fmt.Sprintf("%d", summary.LandTiles))
		@MetricCard("Water tiles", fmt.Sprintf("%d", summary.WaterTiles))
		@MetricCard("Sensors", fmt.Sprintf("%d", summary.SensorCount))
		@MetricCard("Actors", fmt.Sprintf("%d", summary.ActorCount))
		@MetricCard("Incidents", fmt.Sprintf("%d", summary.IncidentCount))
	</section>
}

templ RicartFeed(data RicartPanelData) {
	<section class="feed-card ricart-card" aria-label="Ricart-Agrawala status" data-testid="ricart-feed">
		<div class="ricart-header">
			<div>
				<h2 class="feed-title">Bridge access</h2>
				<p class="ricart-subtitle">Observed from MQTT on the control-center</p>
			</div>
			<span class={ "ricart-state-pill", templ.KV("ricart-state-pill-critical", data.Bridge.Tone == "critical"), templ.KV("ricart-state-pill-warning", data.Bridge.Tone == "warning"), templ.KV("ricart-state-pill-normal", data.Bridge.Tone == "normal") }>
				{ data.Bridge.State }
			</span>
		</div>
		<div class="ricart-grid">
			<div class="ricart-metrics">
				@MetricCard("Online", fmt.Sprintf("%d", data.Overview.OnlineCount))
				@MetricCard("Wanting", fmt.Sprintf("%d", data.Overview.WantingCount))
				@MetricCard("In CS", fmt.Sprintf("%d", data.Overview.InCSCount))
				@MetricCard("Requests", fmt.Sprintf("%d", data.Overview.ActiveRequestCount))
			</div>
			<div class="ricart-bridge-card">
				<div class="ricart-resource-title">{ data.Bridge.Label }</div>
				<div class="ricart-resource-line">holder { data.Bridge.Holder }</div>
				if data.Bridge.Waiting != "" {
					<div class="ricart-resource-line">waiting { data.Bridge.Waiting }</div>
				}
				if data.Bridge.Requesters != "" {
					<div class="ricart-resource-line">requesters { data.Bridge.Requesters }</div>
				}
				<div class="ricart-resource-line">logical clock { data.Bridge.LastLogicalClk }</div>
			</div>
		</div>
		<div class="ricart-columns">
			<div>
				<h3 class="ricart-column-title">Actors</h3>
				<ul class="ricart-list">
					for _, participant := range data.Participants {
						<li class="ricart-list-item" data-testid={ "ricart-participant-" + participant.ActorID }>
							<div>
								<div class="feed-primary">{ participant.ActorID }</div>
								<div class="feed-secondary">{ participant.State }</div>
								<div class="ricart-list-meta">
									if participant.ResourceID != "" {
										<span>resource { participant.ResourceID }</span>
									}
									if participant.RequestClock != "" {
										<span>clock { participant.RequestClock }</span>
									}
								</div>
							</div>
							<div class="ricart-list-aside">
								if participant.Online {
									<span class="ricart-online">online</span>
								} else {
									<span class="ricart-offline">offline</span>
								}
								<time class="feed-time">{ participant.LastSeen }</time>
							</div>
						</li>
					}
				</ul>
			</div>
			<div>
				<h3 class="ricart-column-title">Recent events</h3>
				<ul class="feed-list">
					for _, event := range data.Events {
						<li class="feed-item ricart-event-item">
							<div>
								<div class="feed-primary">{ event.Kind }</div>
								<div class="feed-secondary">
									{ event.ActorID }
									if event.PeerID != "" {
										{ " · " }{ event.PeerID }
									}
									if event.ResourceID != "" {
										{ " · " }{ event.ResourceID }
									}
								</div>
								if event.Detail != "" {
									<div class="ricart-detail">{ event.Detail }</div>
								}
							</div>
							<div class="feed-actions">
								<span class="ricart-clock">{ event.LogicalClock }</span>
								<time class="feed-time">{ event.Timestamp }</time>
							</div>
						</li>
					}
				</ul>
			</div>
		</div>
	</section>
}

templ MetricCard(label string, value string) {
	<div class="status-card" data-testid={ "metric-" + label }>
		<span class="metric-value">{ value }</span>
		<span class="metric-label">{ label }</span>
	</div>
}

templ ReadingsFeed(readings []ReadingListItem) {
	<section class="feed-card" data-testid="readings-feed">
		<h2 class="feed-title">Latest readings</h2>
		if len(readings) == 0 {
			<p class="feed-empty">No readings received</p>
		} else {
			<ul class="feed-list">
				for _, reading := range readings {
					<li class="feed-item">
						<div>
							<div class={ "feed-primary", templ.KV("critical-text", reading.Critical) }>
								{ reading.Type } - { reading.Value }
							</div>
							<div class="feed-secondary">{ reading.SensorID } at { reading.Position }</div>
						</div>
						<time class="feed-time">{ reading.Timestamp }</time>
					</li>
				}
			</ul>
		}
	</section>
}

templ ActorsFeed(actors []ActorListItem) {
	<section class="feed-card" data-testid="actors-feed">
		<h2 class="feed-title">Registered actors</h2>
		if len(actors) == 0 {
			<p class="feed-empty">No actors registered</p>
		} else {
			<ul class="feed-list">
				for _, actor := range actors {
					<li class="feed-item">
						<div>
							<div class="feed-primary">{ actor.ID }</div>
							<div class="feed-secondary" data-actor-row={ actor.ID }>
								{ actor.Type } at <span data-actor-position={ actor.ID }>{ actor.Position }</span>
								<span class="actor-state" data-actor-state={ actor.ID }>{ actor.State }</span>
							</div>
						</div>
					</li>
				}
			</ul>
		}
	</section>
}

templ IncidentItem(incident IncidentListItem) {
	<li class="feed-item" data-testid={ "incident-" + incident.ID }>
		<div>
			<div class="feed-primary critical-text">{ incident.Type }</div>
			<div class="feed-secondary">{ incident.SensorID } at { incident.Position }</div>
			<div class="mission-state" data-incident-mission={ incident.ID }>{ incident.MissionState }</div>
		</div>
		<div class="feed-actions">
			<time class="feed-time">{ incident.Timestamp }</time>
			<button
				type="button"
				class="mission-button"
				data-mission-trigger
				data-incident-id={ incident.ID }
				hx-post={ "/incidents/" + incident.ID + "/mission" }
				hx-swap="outerHTML"
				hx-target={ "[data-testid='incident-" + incident.ID + "']" }
			>
				Assign mission
			</button>
		</div>
	</li>
}

templ IncidentsFeed(incidents []IncidentListItem) {
	<section class="feed-card" data-testid="incidents-feed">
		<h2 class="feed-title">Incident queue</h2>
		if len(incidents) == 0 {
			<p class="feed-empty">No incidents detected</p>
		} else {
			<ul class="feed-list">
				for _, incident := range incidents {
					@IncidentItem(incident)
				}
			</ul>
		}
	</section>
}

templ SensorsFeed(sensors []SensorListItem) {
	<section class="feed-card" data-testid="sensors-feed">
		<h2 class="feed-title">Registered sensors</h2>
		if len(sensors) == 0 {
			<p class="feed-empty">No sensors registered</p>
		} else {
			<ul class="feed-list">
				for _, sensor := range sensors {
					<li class="feed-item">
						<div>
							<div class="feed-primary">{ sensor.ID }</div>
							<div class="feed-secondary">{ sensor.Type } at { sensor.Position }</div>
						</div>
					</li>
				}
			</ul>
		}
	</section>
}
