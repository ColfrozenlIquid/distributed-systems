package html

var dashboardAssetsHandle = templ.NewOnceHandle()

templ BaseLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			@DashboardAssets()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ DashboardAssets() {
	@dashboardAssetsHandle.Once() {
		<style>
			:root {
				color-scheme: light;
				--page: #f4f7f2;
				--panel: #ffffff;
				--ink: #18211f;
				--muted: #65736f;
				--line: #d9e2dc;
				--land: #8eb27f;
				--land-edge: #6e9461;
				--water: #5aa9c8;
				--water-edge: #367d9e;
				--infra: #273238;
				--sensor: #f4c542;
				--warning: #d67b1f;
				--critical: #b91c1c;
				--normal: #1c7c54;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--page);
				color: var(--ink);
			}

			.dashboard-shell {
				min-height: 100vh;
				padding: 24px;
			}

			.dashboard-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 24px;
				margin: 0 auto 20px;
				max-width: 1440px;
			}

			.dashboard-title {
				margin: 0;
				font-size: clamp(1.7rem, 3vw, 2.6rem);
				line-height: 1.05;
				letter-spacing: 0;
			}

			.dashboard-meta {
				margin: 8px 0 0;
				color: var(--muted);
			}

			.dashboard-actions {
				display: flex;
				gap: 10px;
				align-items: center;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			.dashboard-link {
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--panel);
				color: var(--ink);
				display: inline-flex;
				align-items: center;
				gap: 8px;
				min-height: 40px;
				padding: 0 12px;
				text-decoration: none;
				font-weight: 650;
			}

			.dashboard-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
				gap: 18px;
				max-width: 1440px;
				margin: 0 auto;
				align-items: start;
			}

			.map-panel,
			.side-panel,
			.status-card,
			.feed-card {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 8px;
			}

			.map-panel {
				padding: 18px;
				min-width: 0;
			}

			.map-toolbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 14px;
				margin-bottom: 14px;
			}

			.map-heading {
				margin: 0;
				font-size: 1rem;
			}

			.legend {
				display: flex;
				flex-wrap: wrap;
				gap: 8px 12px;
				margin: 0;
				color: var(--muted);
				font-size: .88rem;
			}

			.legend-item {
				display: inline-flex;
				align-items: center;
				gap: 6px;
			}

			.legend-swatch {
				width: 12px;
				height: 12px;
				border-radius: 3px;
				border: 8px solid rgba(0, 0, 0, .18);
			}

			.legend-land { background: var(--land); }
			.legend-water { background: var(--water); }
			.legend-infrastructure { background: var(--infra); }
			.legend-sensor { background: var(--sensor); }
			.legend-incident { background: var(--critical); }

			.world-map {
				display: grid;
				grid-template-columns: repeat(20, minmax(0, 1fr));
				gap: 3px;
				inline-size: 100%;
				aspect-ratio: 1 / 1;
			}

			.map-tile {
				position: relative;
				inline-size: 100%;
				aspect-ratio: 1 / 1;
				border: 1px solid rgba(0, 0, 0, .15);
				border-radius: 4px;
				display: grid;
				place-items: center;
				font-size: clamp(.55rem, 1.2vw, .8rem);
				line-height: 1;
				font-weight: 800;
				color: #fff;
				cursor: default;
				overflow: hidden;
			}

			.map-tile:focus {
				outline: 3px solid #172554;
				outline-offset: 2px;
				z-index: 5;
			}

			.map-tile.is-land {
				background: var(--land);
				border-color: var(--land-edge);
			}

			.map-tile.is-water {
				background: var(--water);
				border-color: var(--water-edge);
			}

			.map-tile.has-infrastructure {
				background: var(--infra);
			}

			.map-tile.has-sensor::after {
				content: "";
				position: absolute;
				right: 3px;
				top: 3px;
				width: 7px;
				height: 7px;
				border-radius: 999px;
				background: var(--sensor);
				box-shadow: 0 0 0 1px rgba(0, 0, 0, .35);
			}

			.map-tile.has-incident {
				box-shadow: inset 0 0 0 3px var(--critical);
			}

			.map-tile.reading-warning {
				box-shadow: inset 0 0 0 3px var(--warning);
			}

			.map-tile.reading-critical {
				box-shadow: inset 0 0 0 3px var(--critical);
			}

			.tile-reading {
				position: absolute;
				inset: auto 2px 2px;
				font-size: .55rem;
				font-weight: 750;
				color: #111827;
				background: rgba(255, 255, 255, .78);
				border-radius: 3px;
				padding: 1px 2px;
				max-width: calc(100% - 4px);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.side-panel {
				padding: 14px;
				display: grid;
				gap: 12px;
			}

			.summary-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 10px;
			}

			.status-card,
			.feed-card {
				padding: 14px;
			}

			.metric-value {
				display: block;
				font-size: 1.55rem;
				font-weight: 800;
			}

			.metric-label {
				display: block;
				color: var(--muted);
				font-size: .82rem;
				margin-top: 2px;
			}

			.feed-title {
				margin: 0 0 10px;
				font-size: .95rem;
			}

			.feed-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 8px;
			}

			.feed-item {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 8px;
				align-items: baseline;
				border-top: 1px solid var(--line);
				padding-top: 8px;
			}

			.feed-item:first-child {
				border-top: 0;
				padding-top: 0;
			}

			.feed-primary {
				font-weight: 700;
				overflow-wrap: anywhere;
			}

			.feed-secondary {
				color: var(--muted);
				font-size: .82rem;
				margin-top: 2px;
			}

			.feed-time {
				color: var(--muted);
				font-size: .78rem;
				white-space: nowrap;
			}

			.feed-empty {
				color: var(--muted);
				margin: 0;
			}

			.critical-text {
				color: var(--critical);
			}

			@media (max-width: 980px) {
				.dashboard-shell {
					padding: 14px;
				}

				.dashboard-header,
				.dashboard-grid {
					grid-template-columns: 1fr;
				}

				.dashboard-header {
					display: grid;
					align-items: start;
				}
			}
		</style>
		<script>
			(() => {
				const maps = document.querySelectorAll("[data-dashboard-map]");
				for (const map of maps) {
					map.addEventListener("click", (event) => {
						const tile = event.target.closest("[data-x][data-y]");
						if (!tile) return;
						map.querySelectorAll("[aria-pressed='true']").forEach((current) => current.setAttribute("aria-pressed", "false"));
						tile.setAttribute("aria-pressed", "true");
					});
				}
			})();
		</script>
	}
}
